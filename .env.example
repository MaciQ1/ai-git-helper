# Replace with a real provider key. Do not commit the real value.
OPENAI_API_KEY=replace-with-real-provider-key

OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
# Klucz dostępu do aplikacji, minimum 32 znaki. Use only letters, digits, - or _.
APP_API_KEY=replace-with-a-64-character-app-key-0000000000000000000000000000
# Opcjonalnie wiele kluczy:
APP_API_KEYS=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_SWAGGER=false
